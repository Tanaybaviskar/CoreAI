# CoreAI Multi-Agent System - Environment Configuration
# Copy this file to .env and fill in your API keys

# ============================================
# Core AI Model Configuration
# ============================================
GOOGLE_API_KEY=AIzaSyCoDhY-64mTTUX5fkzehb1gCbc_JcrAPWs
SERPER_API_KEY=b73411c0768eee3ee149e3750f713e5c7c06ec2f

# ============================================
# Google Workspace OAuth 2.0 (Recommended for Production)
# ============================================
# Get these from: https://console.cloud.google.com/apis/credentials
# 1. Create OAuth 2.0 Client ID
# 2. Download JSON and extract these values:
GOOGLE_CLIENT_ID=your_client_id_from_oauth_credentials.json
GOOGLE_CLIENT_SECRET=your_client_secret_from_oauth_credentials.json
GOOGLE_REDIRECT_URI=http://localhost:5001/oauth/callback

# OAuth Scopes (automatically configured, but you can customize)
GOOGLE_SCOPES=https://www.googleapis.com/auth/calendar,https://www.googleapis.com/auth/gmail.modify,https://www.googleapis.com/auth/meetings.space.created

# Google Workspace Settings
GOOGLE_CALENDAR_ID=primary

# ============================================
# Alternative: Simple API Keys (Limited Access)
# ============================================
# Use these if you haven't set up OAuth yet
# Note: API keys have limited access compared to OAuth
GOOGLE_CALENDAR_API_KEY=your_google_calendar_api_key
GOOGLE_MEET_API_KEY=your_google_meet_api_key
GMAIL_API_KEY=your_gmail_api_key

# ============================================
# Weather API Integration
# ============================================
# Option 1: OpenWeatherMap (Recommended)
# Get from: https://openweathermap.org/api
# Free tier: 60 calls/minute, 1,000,000 calls/month
WEATHER_API_KEY=your_openweathermap_api_key
WEATHER_API_PROVIDER=openweathermap
WEATHER_API_UNITS=metric  # metric, imperial, or kelvin

# Option 2: WeatherAPI.com
# Get from: https://www.weatherapi.com/
# Free tier: 1,000,000 calls/month
# WEATHER_API_KEY=your_weatherapi_key
# WEATHER_API_PROVIDER=weatherapi

# ============================================
# News API Integration
# ============================================
# NewsAPI (https://newsapi.org/)
# Free tier: 100 requests/day, 7-day news history
NEWS_API_KEY=your_newsapi_key
NEWS_API_COUNTRY=us  # us, gb, ca, au, etc.
NEWS_API_LANGUAGE=en

# ============================================
# Communication Platforms
# ============================================

# Slack Integration (https://api.slack.com/apps)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_SIGNING_SECRET=your_slack_signing_secret

# Microsoft Teams (https://portal.azure.com)
MICROSOFT_TEAMS_WEBHOOK=https://outlook.office.com/webhook/YOUR_WEBHOOK
MICROSOFT_APP_ID=your_microsoft_app_id
MICROSOFT_APP_PASSWORD=your_microsoft_app_password
MICROSOFT_TENANT_ID=your_tenant_id

# Discord (https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_WEBHOOK_URL=your_discord_webhook_url

# ============================================
# Task Management Integrations
# ============================================

# Notion (https://www.notion.so/my-integrations)
NOTION_API_KEY=secret_your_notion_integration_token
NOTION_DATABASE_ID=your_database_id

# Trello (https://trello.com/app-key)
TRELLO_API_KEY=your_trello_api_key
TRELLO_TOKEN=your_trello_token

# Asana (https://app.asana.com/0/developer-console)
ASANA_ACCESS_TOKEN=your_asana_personal_access_token

# ============================================
# Database & Storage
# ============================================
DATABASE_URL=sqlite:///coreai.db
REDIS_URL=redis://localhost:6379

# PostgreSQL (Production)
# DATABASE_URL=postgresql://user:password@localhost:5432/coreai

# MongoDB (Alternative)
# MONGODB_URL=mongodb://localhost:27017/coreai

# ============================================
# Cloud Storage (Optional)
# ============================================

# AWS S3
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=your-bucket-name
AWS_REGION=us-east-1

# Google Cloud Storage
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json

# ============================================
# Application Settings
# ============================================
DEBUG=True
PORT=5001
HOST=0.0.0.0
ENVIRONMENT=development  # development, staging, production

# ============================================
# Security
# ============================================
SECRET_KEY=your_secret_key_here_change_in_production_use_random_64_chars
JWT_SECRET=your_jwt_secret_here_change_in_production_use_random_64_chars
JWT_EXPIRATION=86400  # 24 hours in seconds

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
RATE_LIMIT_PER_DAY=10000

# ============================================
# Logging
# ============================================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=logs/coreai.log
LOG_MAX_BYTES=10485760  # 10MB
LOG_BACKUP_COUNT=5

# ============================================
# AI Model Configuration
# ============================================
AI_MODEL=gemini-2.0-flash-exp
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=4000
AI_TOP_P=0.95

# ============================================
# Feature Flags
# ============================================
ENABLE_OAUTH=True
ENABLE_WEATHER_AGENT=True
ENABLE_NEWS_AGENT=True
ENABLE_EMAIL_AGENT=True
ENABLE_CALENDAR_AGENT=True
ENABLE_MEETING_AGENT=True
ENABLE_TASK_AGENT=True
ENABLE_SLACK_INTEGRATION=False
ENABLE_TEAMS_INTEGRATION=False

# ============================================
# Monitoring & Analytics (Optional)
# ============================================

# Sentry (Error Tracking)
SENTRY_DSN=your_sentry_dsn

# Google Analytics
GA_TRACKING_ID=UA-XXXXXXXXX-X

# Mixpanel
MIXPANEL_TOKEN=your_mixpanel_token
